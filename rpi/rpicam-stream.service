[Unit]
Description=RPiCam Camera Stream to MediaMTX
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dan7554
Group=video
EnvironmentFile=/etc/rpicam-stream.conf
ExecStart=/opt/rpicam-stream/rpicam-stream.sh
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rpicam-stream

[Install]
WantedBy=multi-user.target