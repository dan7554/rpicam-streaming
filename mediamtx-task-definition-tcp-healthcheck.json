{
  "family": "mediamtx-task",
  "executionRoleArn": "arn:aws:iam::457553343935:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "mediamtx",
      "image": "457553343935.dkr.ecr.us-east-1.amazonaws.com/mediamtx:latest",
      "cpu": 512,
      "memory": 1024,
      "portMappings": [
        {
          "containerPort": 8554,
          "hostPort": 8554,
          "protocol": "tcp"
        },
        {
          "containerPort": 8888,
          "hostPort": 8888,
          "protocol": "tcp"
        },
        {
          "containerPort": 8889,
          "hostPort": 8889,
          "protocol": "tcp"
        },
        {
          "containerPort": 1935,
          "hostPort": 1935,
          "protocol": "tcp"
        },
        {
          "containerPort": 8890,
          "hostPort": 8890,
          "protocol": "tcp"
        },
        {
          "containerPort": 8891,
          "hostPort": 8891,
          "protocol": "udp"
        },
        {
          "containerPort": 9996,
          "hostPort": 9996,
          "protocol": "tcp"
        },
        {
          "containerPort": 9997,
          "hostPort": 9997,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "command": [
        "/app/mediamtx.yml"
      ],
      "environment": [],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mediamtx",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "mediamtx"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "timeout 1 /bin/bash -c \"\\</dev/tcp/localhost/9997\\\" || exit 1"
        ],
        "interval": 15,
        "timeout": 3,
        "retries": 2,
        "startPeriod": 5
      },
      "systemControls": []
    }
  ]
}
