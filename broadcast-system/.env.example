# Example environment variables for broadcast system development
# Copy this file to .env and update with your values

NODE_ENV=development
PORT=3001
LISTEN_HOST=0.0.0.0

# Local development URL
MEDIAMTX_URL=https://localhost:8889

# Or for remote deployment
# MEDIAMTX_URL=https://stream.example.com:8889

# CORS settings
CORS_ORIGIN=http://localhost:3000,https://localhost
CORS_CREDENTIALS=true

# SSL/TLS (for local development, use self-signed certs)
SSL_CERT_FILE=/etc/nginx/certs/server.crt
SSL_KEY_FILE=/etc/nginx/certs/server.key

# API Configuration
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=15m

# Logging
LOG_LEVEL=debug
LOG_FORMAT=text

# Features
ENABLE_RECORDING=true
ENABLE_STREAMING=true
ENABLE_COMMENTARY=true

# Optional: YouTube Integration
# YOUTUBE_API_KEY=your-api-key
# YOUTUBE_CHANNEL_ID=your-channel-id

# Optional: Google Cloud Storage
# GCS_BUCKET=my-bucket
# GCS_PROJECT_ID=my-project

# Optional: Database
# DATABASE_URL=postgresql://user:pass@localhost:5432/broadcast
