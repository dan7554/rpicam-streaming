{
  "name": "racetrack-broadcast-system",
  "version": "1.0.0",
  "description": "Multi-camera racetrack broadcasting system with voice commentary and YouTube streaming",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "build": "npm run build:client",
    "build:client": "cd client && npm run build",
    "install:all": "npm install && cd client && npm install",
    "docker:build": "docker build -f Dockerfile -t broadcast-system:latest .",
    "docker:build:nc": "docker build --no-cache -f Dockerfile -t broadcast-system:latest .",
    "docker:run": "docker run -d -p 80:80 -p 443:443 --name broadcast-system broadcast-system:latest",
    "docker:run:dev": "docker run -it -p 80:80 -p 443:443 --rm --name broadcast-system broadcast-system:latest",
    "docker:stop": "docker stop broadcast-system && docker rm broadcast-system",
    "docker:logs": "docker logs -f broadcast-system",
    "docker:shell": "docker exec -it broadcast-system sh",
    "compose:up": "docker-compose up -d broadcast-system",
    "compose:down": "docker-compose down",
    "compose:logs": "docker-compose logs -f broadcast-system",
    "compose:build": "docker-compose build broadcast-system",
    "camera:configure": "node scripts/configure-rpi-camera.js",
    "camera:list": "node scripts/camera-manager.js list",
    "camera:test": "node scripts/camera-manager.js test-all",
    "camera:enable": "node scripts/camera-manager.js enable",
    "camera:disable": "node scripts/camera-manager.js disable"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "node-media-server": "^2.6.1",
    "fluent-ffmpeg": "^2.1.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1",
    "socket.io": "^4.7.4",
    "axios": "^1.6.2",
    "sharp": "^0.33.0",
    "node-rtsp-stream": "^0.0.9",
    "@google-cloud/storage": "^7.7.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "broadcasting",
    "streaming",
    "racetrack",
    "mediamtx",
    "webrtc",
    "rtmp",
    "youtube"
  ],
  "author": "Your Name",
  "license": "MIT"
}