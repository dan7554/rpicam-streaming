{
  "family": "mediamtx-task",
  "taskRoleArn": "arn:aws:iam::457553343935:role/ecsTaskExecutionRole",
  "executionRoleArn": "arn:aws:iam::457553343935:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "mediamtx",
      "image": "457553343935.dkr.ecr.us-east-2.amazonaws.com/mediamtx:latest",
      "portMappings": [
        {
          "containerPort": 8554,
          "protocol": "tcp",
          "name": "rtsp"
        },
        {
          "containerPort": 8888,
          "protocol": "tcp",
          "name": "hls"
        },
        {
          "containerPort": 8889,
          "protocol": "tcp",
          "name": "webrtc"
        },
        {
          "containerPort": 1935,
          "protocol": "tcp",
          "name": "rtmp"
        }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mediamtx",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "environment": [
        {
          "name": "MTX_RTSPTRANSPORTS",
          "value": "tcp"
        },
        {
          "name": "MTX_WEBRTCADDITIONALHOSTS",
          "value": "localhost"
        },
        {
          "name": "MTX_HLSADDRESS",
          "value": ":8888"
        },
        {
          "name": "MTX_WEBRTCADDRESS",
          "value": ":8889"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8888/ || exit 1"
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 5
      }
    }
  ],
  "tags": [
    {
      "key": "Environment",
      "value": "production"
    },
    {
      "key": "Application",
      "value": "mediamtx"
    }
  ]
}
