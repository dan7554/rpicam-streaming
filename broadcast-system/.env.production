# Production deployment configuration for broadcast system
# Copy this file to broadcast-system/certs/.env.production before deploying

# Node.js Environment
NODE_ENV=production

# Server Configuration
PORT=3001
LISTEN_HOST=0.0.0.0

# MediaMTX Configuration
MEDIAMTX_URL=https://mediamtx.example.com:8889

# TLS/SSL Configuration
SSL_CERT_FILE=/etc/nginx/certs/server.crt
SSL_KEY_FILE=/etc/nginx/certs/server.key

# CORS Configuration
CORS_ORIGIN=https://yourdomain.com
CORS_CREDENTIALS=true

# API Configuration
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=15m

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Features
ENABLE_RECORDING=true
ENABLE_STREAMING=true
ENABLE_COMMENTARY=true

# Database (if using)
# DATABASE_URL=postgresql://user:pass@db:5432/broadcast

# Google Cloud Storage (if using for recordings)
# GCS_BUCKET=broadcast-system-recordings
# GCS_PROJECT_ID=your-project-id

# YouTube Streaming (if enabling YouTube integration)
# YOUTUBE_API_KEY=your-api-key
# YOUTUBE_CHANNEL_ID=your-channel-id

# Nginx Configuration
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024
NGINX_KEEPALIVE_TIMEOUT=65
NGINX_CLIENT_MAX_BODY_SIZE=20M
NGINX_GZIP_LEVEL=6

# Security
ENABLE_HTTPS_ONLY=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# Performance
ENABLE_HTTP2=true
ENABLE_COMPRESSION=true
CACHE_STATIC_FILES=true
CACHE_DURATION=31536000
