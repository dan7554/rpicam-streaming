{
  "family": "mediamtx-task",
  "executionRoleArn": "arn:aws:iam::457553343935:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "mediamtx",
      "image": "457553343935.dkr.ecr.us-east-1.amazonaws.com/mediamtx:nginx-health",
      "essential": true,
      "portMappings": [
        {
          "name": "rtsp",
          "containerPort": 8554,
          "hostPort": 8554,
          "protocol": "tcp"
        },
        {
          "name": "rtmp",
          "containerPort": 1935,
          "hostPort": 1935,
          "protocol": "tcp"
        },
        {
          "name": "hls",
          "containerPort": 8888,
          "hostPort": 8888,
          "protocol": "tcp"
        },
        {
          "name": "webrtc-tcp",
          "containerPort": 8889,
          "hostPort": 8889,
          "protocol": "tcp"
        },
        {
          "name": "webrtc-udp",
          "containerPort": 8890,
          "hostPort": 8890,
          "protocol": "udp"
        },
        {
          "name": "webrtc-udp2",
          "containerPort": 8891,
          "hostPort": 8891,
          "protocol": "udp"
        },
        {
          "name": "srt",
          "containerPort": 9996,
          "hostPort": 9996,
          "protocol": "tcp"
        },
        {
          "name": "api",
          "containerPort": 9997,
          "hostPort": 9997,
          "protocol": "tcp"
        },
        {
          "name": "health",
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8080/health || exit 1"
        ],
        "interval": 15,
        "timeout": 3,
        "retries": 2,
        "startPeriod": 5
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mediamtx",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "environment": [
        {
          "name": "MTX_RTSPTRANSPORTS",
          "value": "tcp"
        },
        {
          "name": "MTX_WEBRTCADDITIONALHOSTS",
          "value": "localhost"
        }
      ]
    }
  ]
}
